{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "fixhub-web",
  "main": "worker/index.ts",
  "compatibility_date": "2025-09-06",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/api/*"
    ]
  },
  "services": [
    {
      "binding": "API",
      "service": "fixhub-api"
    }
  ]
}
