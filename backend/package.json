{
  "name": "backend",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --port 8787",
    "build": "tsc --noEmit",
    "test": "vitest run --config vitest.config.ts",
    "deploy": "wrangler deploy",
    "db:generate": "drizzle-kit generate --config drizzle.config.ts",
    "db:migrate": "wrangler d1 migrations apply DB --local --config wrangler.jsonc",
    "db:migrate:remote": "wrangler d1 migrations apply DB --remote --config wrangler.jsonc",
    "db:seed": "node seed/seed.mjs",
    "db:backfill-embeddings": "node scripts/backfill-embeddings.mjs"
  },
  "dependencies": {
    "@hono/zod-validator": "^0.7.6",
    "drizzle-orm": "^0.44.7",
    "hono": "^4.8.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.8.19",
    "@cloudflare/workers-types": "^4.20260702.1",
    "@types/node": "^22.20.5",
    "drizzle-kit": "^0.31.4",
    "typescript": "^5.7.3",
    "vitest": "^3.2.4",
    "wrangler": "^4.29.1"
  }
}
